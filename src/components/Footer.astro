---
const footerLinks = {
  info: [
    { label: "Horarios", href: "#" },
    { label: "Clases", href: "#clases" },
    { label: "Entrenadores", href: "#entrenamiento" },
    { label: "Ubicación", href: "https://maps.app.goo.gl/sapHu3zQVyqNFLZE7" },
  ],
  empresa: [
    { label: "Sobre Nosotros", href: "#nosotros" },
    { label: "Membresías", href: "#membresias" },
    { label: "Contacto", href: "https://wa.me/593990039794" },
    { label: "FAQ", href: "#" },
  ],
};

const socials = [
  { label: "Instagram", icon: "IG", href: "https://www.instagram.com/leadergym_ec/" },
  { label: "Facebook", icon: "FB", href: "https://www.facebook.com/leadergym.fx/" },
  { label: "TikTok", icon: "TK", href: "https://www.tiktok.com/@leadergym.official" },
  { label: "Threads", icon: "TH", href: "https://www.threads.com/@leadergym_ec" },
];
---

<footer class="bg-dark-light border-t border-white/5">
  <!-- Tagline -->
  <div class="py-12 border-b border-white/5">
    <div class="max-w-4xl mx-auto text-center">
      <p class="font-heading text-3xl md:text-5xl font-bold uppercase tracking-tight text-white/90">
        M&aacute;s que ejercicio, es identidad.
      </p>
    </div>
  </div>

  <!-- Footer Grid -->
  <div class="px-6 md:px-12 py-16">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-6">
          <img src="/images/icon.jpg" alt="Leader Gym" class="w-10 h-10 object-contain rounded" />
          <div class="flex flex-col leading-none">
            <span class="font-heading text-primary text-base tracking-[0.15em] uppercase font-bold leading-none">
              Leader Gym
            </span>
            <span class="text-white/40 text-[10px] tracking-[0.15em] uppercase font-heading">
              Figura Extrema
            </span>
          </div>
        </a>
        <p class="text-white/70 text-sm leading-relaxed mb-2">
          M&aacute;s que ejercicio, es identidad.
        </p>
        <p class="text-white/60 text-xs leading-relaxed mb-6">
          Bol&iacute;var entre Lourdes y Catacocha, Loja<br />
          Tel: 099 003 9794
        </p>
        <!-- Social -->
        <div class="flex gap-3">
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener"
              class="w-10 h-10 border border-white/10 flex items-center justify-center text-white/70 hover:text-dark hover:bg-primary hover:border-primary transition-all duration-300 text-xs font-heading font-semibold"
              aria-label={social.label}
            >
              {social.icon}
            </a>
          ))}
        </div>
      </div>

      <!-- Links columns -->
      <div>
        <h4 class="font-heading text-sm tracking-[0.2em] uppercase mb-6">Informaci&oacute;n</h4>
        <ul class="space-y-3">
          {footerLinks.info.map((link) => (
            <li>
              <a href={link.href} class="text-white/70 hover:text-primary text-sm transition-colors duration-300">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-heading text-sm tracking-[0.2em] uppercase mb-6">Empresa</h4>
        <ul class="space-y-3">
          {footerLinks.empresa.map((link) => (
            <li>
              <a href={link.href} class="text-white/70 hover:text-primary text-sm transition-colors duration-300">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-heading text-sm tracking-[0.2em] uppercase mb-6">Horario</h4>
        <ul class="space-y-3 text-white/70 text-sm">
          <li>Lun - Vie: 05:00 - 22:30</li>
          <li>S&aacute;bado: 08:00 - 12:00 / 15:00 - 18:00</li>
          <li>Domingo: Cerrado</li>
        </ul>
        <a
          href="https://wa.me/593990039794"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 mt-6 text-primary text-sm font-heading tracking-wider uppercase hover:underline"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom -->
  <div class="border-t border-white/5 px-6 md:px-12 py-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-white/50 text-xs">
        &copy; 2026 Leader Gym&reg;. Todos los derechos reservados.
      </p>
      <p class="text-white/50 text-xs font-heading tracking-wider uppercase">
        Figura Extrema
      </p>
    </div>
  </div>
</footer>
