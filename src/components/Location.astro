<section class="section-padding bg-dark">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col lg:flex-row gap-12 items-center">
      <!-- Map -->
      <div class="fade-in-left w-full lg:w-1/2">
        <div class="relative overflow-hidden aspect-[4/3] bg-dark-card border border-white/10">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1103!2d-79.2017066!3d-4.0027815!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x91cb37cc9e003ad1%3A0x14ff96733fa2f6c4!2sLeader%20Gym!5e0!3m2!1ses!2sec"
            class="w-full h-full border-0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación de Leader Gym en Loja"
          ></iframe>
        </div>
      </div>

      <!-- Info -->
      <div class="fade-in-right w-full lg:w-1/2 space-y-8">
        <div>
          <p class="font-heading text-primary text-sm md:text-base tracking-[0.4em] uppercase mb-4 font-medium">Vis&iacute;tanos</p>
          <h2 class="font-heading text-4xl md:text-5xl font-bold uppercase tracking-tight">
            Enc&uacute;entranos<br />en Loja
          </h2>
        </div>

        <div class="space-y-6">
          <!-- Address -->
          <div class="flex gap-4 items-start">
            <div class="w-12 h-12 bg-primary/10 border border-primary/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-heading text-lg uppercase tracking-wide font-semibold mb-1">Direcci&oacute;n</h3>
              <p class="text-white/80 text-sm leading-relaxed">Bol&iacute;var entre Lourdes y Catacocha<br />Loja, Ecuador</p>
            </div>
          </div>

          <!-- Phone -->
          <div class="flex gap-4 items-start">
            <div class="w-12 h-12 bg-primary/10 border border-primary/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <h3 class="font-heading text-lg uppercase tracking-wide font-semibold mb-1">Tel&eacute;fono</h3>
              <a href="tel:+593990039794" class="text-white/80 text-sm hover:text-primary transition-colors">099 003 9794</a>
            </div>
          </div>

          <!-- Hours -->
          <div class="flex gap-4 items-start">
            <div class="w-12 h-12 bg-primary/10 border border-primary/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-heading text-lg uppercase tracking-wide font-semibold mb-1">Horario</h3>
              <div class="text-white/80 text-sm space-y-1">
                <p>Lunes a Viernes: <strong class="text-white">05:00 - 22:30</strong></p>
                <p>S&aacute;bado: <strong class="text-white">08:00 - 12:00 / 15:00 - 18:00</strong></p>
                <p>Domingo: <strong class="text-white/60">Cerrado</strong></p>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-4">
          <a
            href="https://wa.me/593990039794?text=Hola!%20Quiero%20visitarlos"
            target="_blank"
            rel="noopener"
            class="btn-primary text-center"
          >
            Escr&iacute;benos por WhatsApp
          </a>
          <a
            href="https://maps.app.goo.gl/sapHu3zQVyqNFLZE7"
            target="_blank"
            rel="noopener"
            class="btn-outline text-center"
          >
            C&oacute;mo Llegar
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
