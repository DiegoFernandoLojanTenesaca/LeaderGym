---
const testimonials = [
  {
    name: "Carlos M.",
    role: "Miembro desde 2025",
    text: "Desde que empec\u00e9 en Leader Gym mi vida cambi\u00f3 completamente. Los entrenadores te motivan de verdad y las instalaciones son de otro nivel para Loja.",
    stars: 5,
  },
  {
    name: "Mar\u00eda P.",
    role: "Clases grupales",
    text: "Las clases grupales son incre\u00edbles, el ambiente te empuja a dar m\u00e1s. Me encanta la energ\u00eda que se siente apenas entras. 100% recomendado.",
    stars: 5,
  },
  {
    name: "Andr\u00e9s R.",
    role: "MMA & Culturismo",
    text: "El programa de MMA es muy completo y profesional. Adem\u00e1s la preparaci\u00f3n para competencias de culturismo es seria. Aqu\u00ed se entrena de verdad.",
    stars: 5,
  },
  {
    name: "Valentina S.",
    role: "3 meses entrenando",
    text: "Nunca me hab\u00eda sentido tan c\u00f3moda en un gym. El equipo te hace sentir parte de la familia desde el primer d\u00eda. Figura Extrema no es solo un slogan.",
    stars: 5,
  },
];
---

<section class="section-padding bg-dark-light overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="fade-in text-center mb-16">
      <p class="font-heading text-primary text-sm md:text-base tracking-[0.4em] uppercase mb-4 font-medium">Testimonios</p>
      <h2 class="font-heading text-4xl md:text-6xl font-bold uppercase tracking-tight">
        Lo Que Dicen<br />Nuestros Miembros
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {testimonials.map((t, i) => (
        <div
          class="fade-in bg-dark border border-white/10 p-8 hover:border-primary/30 transition-all duration-500 group"
          style={`transition-delay: ${i * 120}ms`}
        >
          <!-- Stars -->
          <div class="flex gap-1 mb-5">
            {Array.from({ length: t.stars }).map(() => (
              <svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <p class="text-white/80 text-sm leading-relaxed mb-6">
            "{t.text}"
          </p>

          <!-- Author -->
          <div class="mt-auto">
            <p class="font-heading text-lg font-semibold uppercase tracking-wide group-hover:text-primary transition-colors">
              {t.name}
            </p>
            <p class="text-white/60 text-xs font-heading tracking-wider uppercase mt-1">
              {t.role}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Google Rating -->
    <div class="fade-in flex items-center justify-center gap-4 mt-12 pt-8 border-t border-white/5">
      <div class="flex gap-1">
        {Array.from({ length: 5 }).map(() => (
          <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <span class="font-heading text-2xl font-bold">5.0</span>
      <span class="text-white/60 text-sm">en Google &bull; 6 opiniones</span>
    </div>
  </div>
</section>
