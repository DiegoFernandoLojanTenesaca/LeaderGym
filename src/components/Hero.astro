---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Video Background -->
  <div class="absolute inset-0 z-0">
    <img src="/images/banner.png" alt="Leader Gym" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-b from-dark/70 via-dark/50 to-dark"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-5xl mx-auto pt-16">
    <p class="fade-in font-heading text-primary text-base md:text-lg tracking-[0.4em] uppercase mb-6 font-semibold">
      Loja, Ecuador
    </p>

    <h1 class="font-heading text-5xl md:text-7xl lg:text-8xl xl:text-9xl font-bold uppercase leading-[0.95] tracking-tight mb-6">
      <span class="fade-in">M&Aacute;S QUE</span><br />
      <span id="typewriter" class="text-gradient opacity-0" data-text="EJERCICIO"></span>
      <span class="typewriter-cursor text-primary animate-pulse">|</span>
    </h1>

    <p class="fade-in text-white text-lg md:text-xl max-w-2xl mx-auto mb-3 font-light leading-relaxed">
      Es tu casa. Es tu proceso. Es tu transformaci&oacute;n.
    </p>
    <p class="fade-in text-white/70 text-sm md:text-base max-w-xl mx-auto mb-12 tracking-wide">
      Gym &bull; Clases Grupales &bull; MMA &bull; Culturismo
    </p>

    <div class="fade-in flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="https://wa.me/593990039794?text=Hola!%20Quiero%20info%20sobre%20Leader%20Gym" target="_blank" rel="noopener" class="btn-primary">Comenzar Ahora</a>
      <a href="#entrenamiento" class="btn-outline">Conoce M&aacute;s</a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2">
    <span class="text-white/50 text-xs tracking-[0.3em] uppercase font-heading">Scroll</span>
    <div class="w-px h-12 bg-gradient-to-b from-primary/60 to-transparent animate-pulse"></div>
  </div>
</section>
