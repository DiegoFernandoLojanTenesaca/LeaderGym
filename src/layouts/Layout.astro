---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Leader Gym® | Gimnasio en Loja, Ecuador - Figura Extrema",
  description = "Leader Gym® - El mejor gimnasio en Loja, Ecuador. Musculación, MMA, Boxeo, Jiu Jitsu, Funcional, Bailoterapia y más. Abierto L-V 05:00-22:30. Bolívar entre Lourdes y Catacocha."
} = Astro.props;

const siteUrl = Astro.site?.href || "https://leader-gym.vercel.app";
const ogImage = `${siteUrl}images/banner.png`;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- SEO Primary -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="gimnasio Loja, gym Loja Ecuador, Leader Gym, Figura Extrema, musculación, MMA Loja, boxeo Loja, jiu jitsu, funcional, bailoterapia, artes marciales Loja, gimnasio Ecuador, entrenamiento personal Loja, culturismo Loja, clases grupales, defensa personal" />
  <meta name="author" content="Leader Gym®" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={siteUrl} />

  <!-- Geographic SEO -->
  <meta name="geo.region" content="EC-L" />
  <meta name="geo.placename" content="Loja, Ecuador" />
  <meta name="geo.position" content="-4.0027815;-79.2017066" />
  <meta name="ICBM" content="-4.0027815, -79.2017066" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="business.business" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:site_name" content="Leader Gym®" />
  <meta property="og:locale" content="es_EC" />
  <meta property="business:contact_data:street_address" content="Bolívar entre Lourdes y Catacocha" />
  <meta property="business:contact_data:locality" content="Loja" />
  <meta property="business:contact_data:country_name" content="Ecuador" />
  <meta property="business:contact_data:phone_number" content="+593990039794" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Teko:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-MBPRR9W6Y5"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-MBPRR9W6Y5');
  </script>

  <!-- Structured Data JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "GymOrFitnessCenter",
    "name": "Leader Gym",
    "alternateName": "Leader Gym® - Figura Extrema",
    "description": "Gimnasio en Loja, Ecuador. Musculación, MMA, Boxeo, Jiu Jitsu, Funcional, Bailoterapia, Defensa Personal y más.",
    "url": siteUrl,
    "logo": `${siteUrl}images/icon.jpg`,
    "image": ogImage,
    "telephone": "+593990039794",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Bolívar entre Lourdes y Catacocha",
      "addressLocality": "Loja",
      "addressRegion": "Loja",
      "addressCountry": "EC"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": -4.0027815,
      "longitude": -79.2017066
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "05:00",
        "closes": "22:30"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": "Saturday",
        "opens": "08:00",
        "closes": "18:00"
      }
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "reviewCount": "6",
      "bestRating": "5"
    },
    "sameAs": [
      "https://www.instagram.com/leadergym_ec/",
      "https://www.facebook.com/leadergym.fx/",
      "https://www.tiktok.com/@leadergym.official",
      "https://www.threads.com/@leadergym_ec"
    ],
    "priceRange": "$25 - $65 USD",
    "currenciesAccepted": "USD",
    "paymentAccepted": "Cash, Credit Card",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Membresías",
      "itemListElement": [
        { "@type": "Offer", "name": "Plan Básico", "price": "25", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Plan Pro", "price": "40", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Plan Elite", "price": "65", "priceCurrency": "USD" }
      ]
    }
  })} />
</head>
<body>
  <!-- Loading Screen -->
  <div id="loader" class="fixed inset-0 z-[9999] bg-dark flex flex-col items-center justify-center transition-opacity duration-700">
    <div class="loader-bolt mb-6">
      <img src="/images/icon.jpg" alt="" class="w-20 h-20 object-contain rounded-lg" />
    </div>
    <div class="loader-bar w-48 h-1 bg-white/10 rounded overflow-hidden">
      <div class="loader-fill h-full bg-primary rounded"></div>
    </div>
    <p class="font-heading text-primary text-sm tracking-[0.3em] uppercase mt-4 loader-text">Leader Gym</p>
  </div>

<slot />

  <Analytics />

  <script>
    // ========== LOADING SCREEN ==========
    window.addEventListener('load', () => {
      const loader = document.getElementById('loader');
      if (loader) {
        setTimeout(() => {
          loader.style.opacity = '0';
          setTimeout(() => {
            loader.style.display = 'none';
            document.body.classList.remove('overflow-hidden');
          }, 700);
        }, 1800);
      }
    });

    // ========== SCROLL ANIMATIONS ==========
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });

    document.querySelectorAll('.fade-in, .fade-in-left, .fade-in-right, .scale-in').forEach((el) => {
      observer.observe(el);
    });

    // ========== ANIMATED COUNTERS ==========
    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = el.dataset.target || '0';
          const isNumber = /^\d+$/.test(target);
          if (isNumber) {
            const end = parseInt(target);
            const duration = 2000;
            const startTime = performance.now();
            const tick = (now: number) => {
              const elapsed = now - startTime;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              el.textContent = Math.floor(eased * end).toString();
              if (progress < 1) requestAnimationFrame(tick);
              else el.textContent = target;
            };
            requestAnimationFrame(tick);
          } else {
            el.textContent = target;
          }
          counterObserver.unobserve(el);
        }
      });
    }, { threshold: 0.5 });

    document.querySelectorAll('[data-counter]').forEach(el => counterObserver.observe(el));

    // ========== PARALLAX ==========
    const parallaxElements = document.querySelectorAll('[data-parallax]');
    if (parallaxElements.length > 0) {
      window.addEventListener('scroll', () => {
        const scrollY = window.scrollY;
        parallaxElements.forEach((el) => {
          const htmlEl = el as HTMLElement;
          const speed = parseFloat(htmlEl.dataset.parallax || '0.3');
          const rect = htmlEl.getBoundingClientRect();
          const offset = (rect.top + scrollY - window.innerHeight / 2) * speed;
          htmlEl.style.transform = `translateY(${-offset}px)`;
        });
      }, { passive: true });
    }

    // ========== 3D TILT ON CARDS ==========
    document.querySelectorAll('[data-tilt]').forEach(card => {
      const el = card as HTMLElement;
      el.addEventListener('mousemove', (e: Event) => {
        const me = e as MouseEvent;
        const rect = el.getBoundingClientRect();
        const x = me.clientX - rect.left;
        const y = me.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -8;
        const rotateY = ((x - centerX) / centerX) * 8;
        el.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
      });
      el.addEventListener('mouseleave', () => {
        el.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) scale(1)';
      });
    });

    // ========== TYPEWRITER ==========
    const typewriterEl = document.getElementById('typewriter');
    if (typewriterEl) {
      const text = typewriterEl.dataset.text || '';
      typewriterEl.textContent = '';
      typewriterEl.style.opacity = '1';
      let i = 0;
      const typeInterval = setInterval(() => {
        typewriterEl.textContent += text.charAt(i);
        i++;
        if (i >= text.length) clearInterval(typeInterval);
      }, 60);
    }
  </script>
</body>
</html>
